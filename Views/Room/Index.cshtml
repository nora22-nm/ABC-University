@model List<ABC_University.Models.Room>



<table cellpadding="0" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>ID</th>
            <th>Room Name</th>
            <th>Room Size</th>
            <th>Is Available</th>
            <th>Location</th>
            <th> Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var room in Model)
        {
        <tr>
            <td>@room.roomID</td>
            <td><a href="/Room/GetDetails/@room.roomID">@room.roomName</a></td>
            <td>@room.roomSize</td>
            <td>@(room.isAvailable ? "Yes" : "No")</td>
            <td>@room.location</td>
            <td><a href="/Room/EditRoom/@room.roomID">Edit</a></td>
            <td><a href="/Room/DeleteRoom/@room.roomID">Delete</a></td>
        </tr>
        }
    </tbody>
</table>
