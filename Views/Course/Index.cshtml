@model List<ABC_University.Models.Course>



<table cellpadding="0" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>ID</th>
            <th>Course Name</th>
            <th>Is Available</th>
            <th> Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
        <tr>
            <td>@course.courseID</td>
            <td><a href="/Course/GetDetails/@course.courseID">@course.courseName</a></td>
            <td>@(course.isAvailable ? "Yes" : "No")</td>
            <td><a href="/Course/EditCourse/@course.courseID">Edit</a></td>
            <td><a href="/Course/DeleteCourse/@course.courseID">Delete</a></td>
        </tr>
        }
    </tbody>
</table>


